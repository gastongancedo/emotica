# ─────────────────────────────────────────────────────────────
# Sin ninguna de estas variables la app arranca igual, usando el
# almacén de archivo local (data/beatmatch.json). Sirve para
# desarrollo y para mostrar la app, NO para producción.
# ─────────────────────────────────────────────────────────────

# Supabase — cuando estén las dos, la app las usa automáticamente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de la service role. Solo en el servidor, nunca con prefijo
# NEXT_PUBLIC_. La necesitan la moderación y la escritura de perfiles.
SUPABASE_SERVICE_ROLE_KEY=

# Clave para entrar a /admin. Cambiala antes de publicar.
ADMIN_KEY=beatmatch

# URL pública del sitio, para armar los links de edición de perfil
NEXT_PUBLIC_SITE_URL=http://localhost:3000
